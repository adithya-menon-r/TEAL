# Copy to .env.local for local development (never commit .env.local).
# In production these are set as Cloudflare Pages environment variables (PLAN.md §5.2).
# All VITE_* values end up in the browser bundle, so nothing secret belongs here.

# 1 = run fully in the browser with fake auth + a fake teal-api (no Firebase/backend needed).
#     Force error cases with ?mock=launches_disabled|capacity_full|provision_failed|unknown_template|start_failed|short|slow|offline
#     (comma-separate to combine, ?mock=none to clear).
VITE_MOCK=1

# teal-api base URL, no trailing slash, e.g. https://teal-api-xxxxxxxxxx-el.a.run.app
VITE_API_URL=

# Firebase web app config (Firebase console → Project settings → Your apps → Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
