{
  "name": "teal-file-download",
  "displayName": "TEAL File Download",
  "description": "Download files directly to your computer from TEAL",
  "version": "1.0.0",
  "publisher": "teal",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:teal.downloadFile"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "teal.downloadFile",
        "title": "Download File",
        "icon": "$(cloud-download)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "teal.downloadFile",
          "when": "!explorerResourceIsFolder",
          "group": "navigation@1"
        }
      ],
      "editor/title/context": [
        {
          "command": "teal.downloadFile",
          "group": "navigation"
        }
      ]
    }
  }
}
